---
interface Props {
  name: string;
  image: string;
  id: number | string;
}

const { name, image, id } = Astro.props;
---

<div class="bg-white/20 backdrop-blur-md rounded-xl shadow-md flex flex-col items-center p-4 border border-white/30">
  <img
    src={image}
    alt={name}
    class="w-20 h-20 object-contain mb-2 drop-shadow-md"
    loading="lazy"
  />
  <h2 class="capitalize text-lg font-semibold text-black mb-2 text-center">{name}</h2>
  <a href={`/pokemons/${id}`} class="mt-2 w-full">
    <button class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded transition-colors">
      Ver Pokémon
    </button>
  </a>
</div>
