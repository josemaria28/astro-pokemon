---
import { typesPokemon } from "@utils/utils";
import Title from "./Title.astro";
---

<section class="mt-20 mb-20">
  <div class="container mx-auto">
    <Title title="Categorias de Pokemones" />
    <div
      class="grid lg:grid-cols-6 sm:grid-cols-3 grid-cols-1 gap-4 pt-15 pb-15"
    >
      {
        typesPokemon.map(({ type, color }) => (
          <div
            class="m-2 p-2 text-lg border-solid border-2 border-black rounded-lg shadow-xl hover:scale-125 transition-transform duration-300"
            style={`background-color: ${color};`}
          >
            <p class="text-lg text-center text-white font-mono uppercase">
              {type}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
