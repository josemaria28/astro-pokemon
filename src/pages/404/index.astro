---
import BaseLayout from "@/layout/BaseLayout.astro";
import { Image } from "astro:assets";
import sladd from "@assets/sladd.png";
---

<BaseLayout>
  <section class="h-full">
    <div
    class="h-full flex flex-col items-center justify-center text-center gap-2"
    >
    <Image
      src={sladd}
      alt="sladd"
      width={300}
      height={300}
    />
      <h1 class="text-4xl font-bold text-gray-800">Página no encontrada</h1>
      <p class="text-gray-600">Lo sentimos, la página que buscas no existe.</p>
      <a
        href="/"
        class="mt-5 bg-yellow-400 hover:bg-yellow-500 text-blue-900 font-semibold px-6 py-2 rounded shadow transition-colors duration-200 inline-block"
        >Volver al inicio</a
      >
    </div>
  </section>
</BaseLayout>
