---
import Title from "@/components/Title.astro";
import BaseLayout from "@/layout/BaseLayout.astro";
---

<BaseLayout title="About">
    <section class="container mx-auto py-8">
        <Title title="About" />
        <div class="py-8">
            <p class="text-gray-700 mb-6">
                La pagina debe de mistrar parrafos de texto que expliquen
                el proposito del proyecto, como se puede contribuir, y cualquier
                otra informacion relevante.
                Puedes utilizar Lorem Ipsum o cualquier otro texto de ejemplo
                para llenar el contenido de la pagina.
            </p>
        </div>
    </section>
</BaseLayout>
