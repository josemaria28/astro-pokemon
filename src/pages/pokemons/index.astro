---
import CardPokemones from "@/components/cardPokemones.astro";
import Title from "@/components/Title.astro";
import BaseLayout from "@/layout/BaseLayout.astro";

const pokemons = [
  {
    name: "bulbasaur",
    id: 1,
    image:
      "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/1.png",
  },
  {
    name: "ivysaur",
    id: 2,
    image:
      "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/2.png",
  },
  {
    name: "venusaur",
    id: 3,
    image:
      "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/3.png",
  },
  {
    name: "charmander",
    id: 4,
    image:
      "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/4.png",
  },
  {
    name: "charmeleon",
    id: 5,
    image:
      "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/5.png",
  },
];
---

<BaseLayout title="Pokemons">
  <section class="container mx-auto py-8">
    <Title title="Todos los pokemones" />
    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6 py-8">
      {pokemons.map((pokemon) => <CardPokemones {...pokemon} />)}
    </div>
  </section>
</BaseLayout>
