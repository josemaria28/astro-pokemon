---
import Title from "@/components/Title.astro";
import BaseLayout from "@/layout/BaseLayout.astro";
---

<BaseLayout title="Contact">
    <section class="container mx-auto py-8">
        <Title title="Contact" />
        <div class="py-8">
            <p class="text-gray-700 mb-6">
                Formulario de contacto para que los usuarios puedan enviar
                preguntas, comentarios o sugerencias sobre el proyecto.
                Puedes utilizar un formulario simple con campos para el nombre,
                correo electrónico y mensaje, o utilizar un servicio de terceros
                para manejar los envíos de formularios.
            </p>
        </div>
    </section>
</BaseLayout>
